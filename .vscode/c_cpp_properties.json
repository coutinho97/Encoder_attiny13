{
    "configurations": [
        {
            "name": "AVR",
            "includePath": [
                "${workspaceFolder}/**",
                "/usr/avr/include/**"
            ],
            "defines": [
                "F_CPU=9600000UL"
            ],
            "compilerPath": "/usr/bin/avr-gcc",
            "cStandard": "gnu11",
            "cppStandard": "gnu++14",
            "intelliSenseMode": "linux-gcc-x86",
            "compilerArgs": [
                "-mmcu=attiny13"
            ]
        }
    ],
    "version": 4
}